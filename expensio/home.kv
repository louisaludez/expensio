<HomeScreen>:
    BoxLayout:
        orientation: "vertical"
        spacing: 0
        padding: 0

        # Top Bar
        BoxLayout:
            size_hint_y: None
            height: 60
            padding: [15, 10, 15, 20]
            canvas.before:
                Color:
                    rgba: 0, 0, 0, 1
                Rectangle:
                    pos: self.x, self.y - 100
                    size: self.width, self.height + 250
                Color:
                    rgba: 1, 1, 1, 1
                Ellipse:
                    size: self.width,100
                    pos: self.x, self.y - 150

            Button:
                
                size_hint_x: None
                size_hint_y: None
                width: 25
                height: 25
                background_color: 0, 0, 0, 0
                on_release:
                    print("Menu clicked")
                Image:
                    source: "assets/menus.png"
                    center_x: self.parent.center_x
                    center_y: self.parent.center_y
                    size_hint: None, None
                    size: 25, 25  

            Label:
                text: "[color=#07334E]Expens[/color][color=#AD590C]io[/color]"
                markup: True
                font_size: 20
                bold: True
                halign: "center"
                valign: "middle"
                text_size: self.width, None

            Button:
               
                size_hint_x: None
                size_hint_y: None
                width: 25
                height: 25
                background_color: 0, 0, 0, 0
                on_release:
                    print("Settings clicked")
                Image:
                    source: "assets/settings.png"
                    center_x: self.parent.center_x
                    center_y: self.parent.center_y
                    size_hint: None, None
                    size: 25, 25
                
               

        # Content Area
        BoxLayout:
            orientation: "vertical"
            spacing: 20
            padding: [20, 0, 20, 20]

            # Total Balance Card
            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                size_hint_x: None
                height: 160
                width: 265
                padding: [20, 10, 20, 20]
                spacing: 10
                canvas.before:
                    Color:
                        rgba: app.get_color_from_hex("#07344E")
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [20]

                BoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: 20
                    spacing: 5  # small gap between label and icon

                    Label:
                        text: "TOTAL BALANCE"
                        color: 1, 1, 1, 1
                        font_size: 12
                        bold: True
                        halign: "left"
                        valign: "middle"
                        size_hint_x: None
                    

                    Button:
                        background_color: 0, 0, 0, 0
                        background_normal: ""
                        size_hint: None, None
                        size: 20, 20
                        on_release:
                            print("Edit balance clicked")
                        Image:
                            source: "assets/edit.png"
                            center_x: self.parent.center_x
                            center_y: self.parent.center_y
                            size_hint: None, None
                            size: 16, 16

                Label:
                    text: "₱ 5,690.00"
                    color: app.get_color_from_hex("#AD590C")
                    font_size: 18
                    bold: True
                    halign: "left"
                    valign: "middle"
                    size_hint_y: None
                    height: 50
                    text_size: self.width, None

                BoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: 40
                    spacing: 30

                    BoxLayout:
                        orientation: "vertical"
                        size_hint_x: 0.5
                        spacing: 5

                        Label:
                            text: "Savings"
                            color: 1, 1, 1, 1
                            font_size: 12
                            halign: "left"
                            valign: "middle"
                            size_hint_y: None
                            height: self.texture_size[1]
                            text_size: self.width, None

                        Label:
                            text: "₱ 2,000.00"
                            color: app.get_color_from_hex("#00D4AA")
                            font_size: 16
                            bold: True
                            halign: "left"
                            valign: "middle"
                            size_hint_y: None
                            height: self.texture_size[1]
                            text_size: self.width, None

                    BoxLayout:
                        orientation: "vertical"
                        size_hint_x: 0.5
                        spacing: 5

                        Label:
                            text: "Expenses"
                            color: 1, 1, 1, 1
                            font_size: 12
                            halign: "left"
                            valign: "middle"
                            size_hint_y: None
                            height: self.texture_size[1]
                            text_size: self.width, None

                        Label:
                            text: "₱ 1,014.00"
                            color: 1, 1, 1, 1
                            font_size: 16
                            bold: True
                            halign: "left"
                            valign: "middle"
                            size_hint_y: None
                            height: self.texture_size[1]
                            text_size: self.width, None

            # Transactions Section Header
            BoxLayout:
                orientation: "horizontal"
                size_hint_y: None
                height: 30
                padding: [0, 0, 0, 10]

                Label:
                    text: "[b]TRANSACTIONS[/b]"
                    markup: True
                    color: 0, 0, 0, 1
                    font_size: 16
                    bold: True
                    halign: "left"
                    valign: "middle"
                    size_hint_x: 1
                    text_size: self.width, None

                Button:
                    text: "See All"
                    background_color: 0, 0, 0, 0
                    color: 0.5, 0.5, 0.5, 1
                    font_size: 14
                    size_hint_x: None
                    width: self.texture_size[0] + 10
                    background_normal: ""
                    on_release:
                        print("See All clicked")

            # Scrollable Transaction Items
            ScrollView:
                do_scroll_x: False
                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: 10

                    # Food Transaction
                    BoxLayout:
                        orientation: "horizontal"
                        size_hint_y: None
                        height: 55
                        spacing: 12

                        FloatLayout:
                            size_hint_x: None
                            width: 40
                            height: 40
                            canvas.before:
                                Color:
                                    rgba: 0.6, 0.4, 0.2, 1
                                Ellipse:
                                    pos: self.pos
                                    size: self.size
                            Image:
                                source: "assets/food.png"
                                size_hint: None, None
                                size: 24, 24
                                pos_hint: {"center_x": 0.5, "center_y": 0.5}
                                allow_stretch: True

                        BoxLayout:
                            orientation: "vertical"
                            size_hint_x: 1
                            spacing: 3
                            halign: "left"

                            Label:
                                text: "[b]Food[/b]"
                                markup: True
                                color: 0, 0, 0, 1
                                font_size: 14
                                bold: True
                                halign: "left"
                                valign: "middle"
                                size_hint_y: None
                                height: self.texture_size[1]
                                text_size: self.width, None

                            Label:
                                text: "Lunch at a restaurant"
                                color: 0.5, 0.5, 0.5, 1
                                font_size: 11
                                halign: "left"
                                valign: "middle"
                                size_hint_y: None
                                height: self.texture_size[1]
                                text_size: self.width, None

                        BoxLayout:
                            orientation: "vertical"
                            size_hint_x: None
                            width: 90
                            spacing: 3

                            Label:
                                text: "[b]₱395[/b]"
                                markup: True
                                color: 0, 0, 0, 1
                                font_size: 14
                                bold: True
                                halign: "right"
                                valign: "middle"
                                size_hint_y: None
                                height: self.texture_size[1]
                                text_size: self.width, None

                            Label:
                                text: "Oct. 17, 2025"
                                color: 0.5, 0.5, 0.5, 1
                                font_size: 10
                                halign: "right"
                                valign: "middle"
                                size_hint_y: None
                                height: self.texture_size[1]
                                text_size: self.width, None

                    # Transport Transaction
                    BoxLayout:
                        orientation: "horizontal"
                        size_hint_y: None
                        height: 55
                        spacing: 12

                        FloatLayout:
                            size_hint_x: None
                            width: 40
                            height: 40
                            canvas.before:
                                Color:
                                    rgba: 0, 0, 0, 1
                                Ellipse:
                                    pos: self.pos
                                    size: self.size
                            Image:
                                source: "assets/transport.png"
                                size_hint: None, None
                                size: 24, 24
                                pos_hint: {"center_x": 0.5, "center_y": 0.5}
                                allow_stretch: True

                        BoxLayout:
                            orientation: "vertical"
                            size_hint_x: 1
                            spacing: 3
                            halign: "left"

                            Label:
                                text: "[b]Transport[/b]"
                                markup: True
                                color: 0, 0, 0, 1
                                font_size: 14
                                bold: True
                                halign: "left"
                                valign: "middle"
                                size_hint_y: None
                                height: self.texture_size[1]
                                text_size: self.width, None

                            Label:
                                text: "Bus ticket"
                                color: 0.5, 0.5, 0.5, 1
                                font_size: 11
                                halign: "left"
                                valign: "middle"
                                size_hint_y: None
                                height: self.texture_size[1]
                                text_size: self.width, None

                        BoxLayout:
                            orientation: "vertical"
                            size_hint_x: None
                            width: 90
                            spacing: 3

                            Label:
                                text: "[b]₱120[/b]"
                                markup: True
                                color: 0, 0, 0, 1
                                font_size: 14
                                bold: True
                                halign: "right"
                                valign: "middle"
                                size_hint_y: None
                                height: self.texture_size[1]
                                text_size: self.width, None

                            Label:
                                text: "Oct. 19, 2025"
                                color: 0.5, 0.5, 0.5, 1
                                font_size: 10
                                halign: "right"
                                valign: "middle"
                                size_hint_y: None
                                height: self.texture_size[1]
                                text_size: self.width, None

                    # Shopping Transaction
                    BoxLayout:
                        orientation: "horizontal"
                        size_hint_y: None
                        height: 55
                        spacing: 12

                        FloatLayout:
                            size_hint_x: None
                            width: 40
                            height: 40
                            canvas.before:
                                Color:
                                    rgba: app.get_color_from_hex("#07344E")
                                Ellipse:
                                    pos: self.pos
                                    size: self.size
                            Image:
                                source: "assets/shopping.png"
                                size_hint: None, None
                                size: 24, 24
                                pos_hint: {"center_x": 0.5, "center_y": 0.5}
                                allow_stretch: True

                        BoxLayout:
                            orientation: "vertical"
                            size_hint_x: 1
                            spacing: 3
                            halign: "left"

                            Label:
                                text: "[b]Shopping[/b]"
                                markup: True
                                color: 0, 0, 0, 1
                                font_size: 14
                                bold: True
                                halign: "left"
                                valign: "middle"
                                size_hint_y: None
                                height: self.texture_size[1]
                                text_size: self.width, None

                            Label:
                                text: "New shirt"
                                color: 0.5, 0.5, 0.5, 1
                                font_size: 11
                                halign: "left"
                                valign: "middle"
                                size_hint_y: None
                                height: self.texture_size[1]
                                text_size: self.width, None

                        BoxLayout:
                            orientation: "vertical"
                            size_hint_x: None
                            width: 90
                            spacing: 3

                            Label:
                                text: "[b]₱499[/b]"
                                markup: True
                                color: 0, 0, 0, 1
                                font_size: 14
                                bold: True
                                halign: "right"
                                valign: "middle"
                                size_hint_y: None
                                height: self.texture_size[1]
                                text_size: self.width, None

                            Label:
                                text: "Oct. 25, 2025"
                                color: 0.5, 0.5, 0.5, 1
                                font_size: 10
                                halign: "right"
                                valign: "middle"
                                size_hint_y: None
                                height: self.texture_size[1]
                                text_size: self.width, None

            # Action Buttons
            BoxLayout:
                orientation: "horizontal"
                size_hint_y: None
                height: 50
                spacing: 15
                padding: [0, 10, 0, 0]

                Button:
                    text: "Monthly Budget"
                    background_color: 0, 0, 0, 0
                    color: 1, 1, 1, 1
                    font_size: 14
                    bold: True
                    background_normal: ""
                    canvas.before:
                        Color:
                            rgba: app.get_color_from_hex("#07344E")
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [8]
                    on_release:
                        print("Monthly Budget clicked")

                Button:
                    text: "Add Transaction"
                    background_color: 0, 0, 0, 0
                    color: 1, 1, 1, 1
                    font_size: 14
                    bold: True
                    background_normal: ""
                    canvas.before:
                        Color:
                            rgba: app.get_color_from_hex("#AD590C")
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [8]
                    on_release:
                        app.root.current = 'add_transaction'

        # Bottom Navigation Bar
        BoxLayout:
            size_hint_y: None
            height: 60
            padding: [15, 5, 15, 5]
            spacing: 30
            canvas.before:
                Color:
                    rgba: 1, 1, 1, 1
                Rectangle:
                    pos: self.pos
                    size: self.size

            FloatLayout:
                size_hint_x: None
                width: 25
                height: 25
                Button:
                    background_color: 0, 0, 0, 0
                    background_normal: ""
                    size_hint: 1, 1
                    on_release:
                        print("Home clicked")
                        app.root.current = 'home'
                Image:
                    source: "assets/home.png"
                    size_hint: None, None
                    size: 25, 25
                    pos_hint: {"center_x": 0.5, "center_y": 0.5}
                    allow_stretch: True

            FloatLayout:
                size_hint_x: None
                width: 25
                height: 25
                Button:
                    background_color: 0, 0, 0, 0
                    background_normal: ""
                    size_hint: 1, 1
                    on_release:
                        print("Category clicked")
                        app.root.current = 'category'
                Image:
                    source: "assets/calendar.png"
                    size_hint: None, None
                    size: 25, 25
                    pos_hint: {"center_x": 0.5, "center_y": 0.5}
                    allow_stretch: True

            FloatLayout:
                size_hint_x: None
                width: 50
                height: 50
                canvas.before:
                    Color:
                        rgba: app.get_color_from_hex("#07344E")
                    Ellipse:
                        pos: self.pos
                        size: self.size
                Button:
                    background_color: 0, 0, 0, 0
                    background_normal: ""
                    size_hint: 1, 1
                    on_release:
                        print("Add Transaction clicked")
                        app.root.current = 'add_transaction'
                Image:
                    source: "assets/plus.png"
                    size_hint: None, None
                    size: 30, 30
                    pos_hint: {"center_x": 0.5, "center_y": 0.5}
                    allow_stretch: True


            FloatLayout:
                size_hint_x: None
                width: 25
                height: 25
                Button:
                    background_color: 0, 0, 0, 0
                    background_normal: ""
                    size_hint: 1, 1
                    on_release:
                        print("Notification clicked")
                        app.root.current = 'notif'
                Image:
                    source: "assets/notification.png"
                    size_hint: None, None
                    size: 25, 25
                    pos_hint: {"center_x": 0.5, "center_y": 0.5}
                    allow_stretch: True

            FloatLayout:
                size_hint_x: None
                width: 25
                height: 25
                Button:
                    background_color: 0, 0, 0, 0
                    background_normal: ""
                    size_hint: 1, 1
                    on_release:
                        print("Profile clicked")
                Image:
                    source: "assets/profile.png"
                    size_hint: None, None
                    size: 25, 25
                    pos_hint: {"center_x": 0.5, "center_y": 0.5}
                    allow_stretch: True

