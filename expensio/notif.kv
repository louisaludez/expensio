<NotifScreen>:
    BoxLayout:
        orientation: "vertical"
        spacing: 0
        padding: 0

        # Top Bar
        BoxLayout:
            size_hint_y: None
            height: 60
            padding: [15, 10, 15, 20]
            canvas.before:
                Color:
                    rgba: app.get_color_from_hex("#FFFFFF")
                Rectangle:
                    pos: self.x, self.y
                    size: self.width, self.height

            Button:
                
                size_hint_x: None
                size_hint_y: None
                width: 20
                height: 20
                background_color: 0, 0, 0, 0
                on_release:
                    print("Menu clicked")
                Image:
                    source: "assets/left-arrow.png"
                    center_x: self.parent.center_x
                    center_y: self.parent.center_y
                    size_hint: None, None
                    size: 20, 20

            Label:
                text: "[color=#07334E]Expens[/color][color=#AD590C]io[/color]"
                markup: True
                font_size: 20
                bold: True
                halign: "center"
                valign: "middle"
                text_size: self.width, None

            Button:
               
                size_hint_x: None
                size_hint_y: None
                width: 20
                height: 20
                background_color: 0, 0, 0, 0
                on_release:
                    print("Settings clicked")
                Image:
                    source: "assets/settings-b.png"
                    center_x: self.parent.center_x
                    center_y: self.parent.center_y
                    size_hint: None, None
                    size: 20, 20
                
               
               
        # Header Section (above ScrollView)
        BoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: 80
            padding: [20, 15, 20, 10]
            spacing: 5
            canvas.before:
                Color:
                    rgba: 1, 1, 1, 1
                Rectangle:
                    pos: self.pos
                    size: self.size

            # Date Row
            Label:
                id: date_label
                text: "Friday, Oct 31"
                color: 0.5, 0.5, 0.5, 1
                font_size: 12
                halign: "left"
                valign: "middle"
                size_hint_y: None
                height: 20
                text_size: self.width, None

            # Title Row with Clear Button
            BoxLayout:
                orientation: "horizontal"
                size_hint_y: None
                height: 35

                Label:
                    text: "Notifications"
                    color: 0, 0, 0, 1
                    font_size: 20
                    bold: True
                    halign: "left"
                    valign: "middle"
                    size_hint_x: 1
                    text_size: self.width, None

                Button:
                    text: "Clear"
                    background_color: 0, 0, 0, 0
                    background_normal: ""
                    color: 0, 0, 0, 1
                    font_size: 14
                    size_hint_x: None
                    width: 50
                    height: 30
                    on_release:
                        root.clear_all_notifications()

        # Content Area
        ScrollView:
            id: notifications_scroll
            size_hint_y: 1
            do_scroll_x: False
            do_scroll_y: True
            BoxLayout:
                orientation: "vertical"
                spacing: 12
                padding: [20, 10, 20, 20]
                size_hint_y: None
                height: self.minimum_height
        
        # Bottom Navigation Bar
        BottomNavBar:
