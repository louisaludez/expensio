
<CategoryScreen>:
    BoxLayout:
        orientation: "vertical"
        spacing: 0
        padding: 0

        # Top Bar
        TopBar:
                
               
              
        # Header Section 
        BoxLayout:                  
            size_hint_y: None
            height: 40
            padding: [15, 0, 15, 0]
            canvas.before:
                Color:
                    rgba: 0,0,0,0
                Rectangle:
                    pos: self.pos
                    size: self.size

            Label:
                text: "Expenses Category"
                font_size: 14
                bold: True
                halign: "left"
                valign: "middle"
                color: app.get_color_from_hex("#000000")
                text_size: self.width, None
            BoxLayout:
                size_hint_x: 1
                width: 20
                spacing: 10
                padding: [10, 0, 0, 0]
                background_color: 0,0,0,1
                canvas.before:
                    Color:
                        rgba: app.get_color_from_hex("#E0E0E0")
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [8]
                    Line:
                        rectangle: self.x, self.y, self.width, self.height
                        width: 1

                Image:
                    source: "assets/search.png"
                    size_hint: None, None
                    size: 20, 20
                    pos_hint: {"center_x": 0.5, "center_y": 0.5}
                    allow_stretch: True
                TextInput:
                    id: search_input
                    text: ''
                    size_hint_x: 1
                    hint_text: 'Search'
                    background_color: 0,0,0,0
                    foreground_color: app.get_color_from_hex("#000000")
                    background_normal: ''
                    background_active: ''
                    padding_y: [self.height / 2 - self.line_height / 2]
                    on_text: root.on_search_text(self, self.text)
        
        # Main Content Area (ScrollView)
        BoxLayout:
            orientation: 'vertical'
            spacing: 10
            padding: [10, 10, 10, 0]
            size_hint: 1, 1
            
            Button:
                text: 'Personal'
                background_normal: ''
                background_color: 0,0,0,0
                background_down: ''
                color: app.get_color_from_hex("#FFFFFF")    
                font_size: 12
                bold: True
                size_hint_y: None
                size_hint_x: None
                height: 30
                width: 90
                on_release: root.filter_personal()
                canvas.before:
                    Color:
                        rgba: app.get_color_from_hex("#07344E")
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [10]
            ScrollView:
                id: category_scroll
                do_scroll_x: True
                do_scroll_y: False

                BoxLayout:
                    orientation:'horizontal'
                    size_hint_x: None
                    size_hint_y: None
                    width: self.minimum_width
                    padding: [5, 30, 10, 0]
                    spacing: 15
#Bills Category Section
            BoxLayout:   
                size_hint_y: None
                size_hint_x: 1
                orientation: 'horizontal'
                spacing: 10
                height: 10   
                Button:
                    text: 'Bills'
                    background_normal: ''
                    background_color: 0,0,0,0
                    background_down: ''
                    color: app.get_color_from_hex("#FFFFFF")    
                    font_size: 12
                    bold: True
                    size_hint_y: None
                    size_hint_x: None
                    height: 30
                    width: 90
                    on_release: root.filter_bills()
                    canvas.before:
                        Color:
                            rgba: app.get_color_from_hex("#AD590C")
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [10]
                Button:
                
                    size_hint_x: 1
                    size_hint_y: None
                    width: 60
                    height: 30
                    background_color: 0, 0, 0, 0
            
                    on_release:
                        print("Menu clicked")
                    Image:
                        source: "assets/right-arrow.png"
                        center_x: self.parent.center_x 
                        center_y: self.parent.center_y
                        size_hint: None, None
                        size: 20, 20

            ScrollView:
                id: bills_scroll
                do_scroll_x: True
                do_scroll_y: False
                
                BoxLayout:
                    orientation:'horizontal'
                    size_hint_x: None
                    size_hint_y: None
                    padding: [10, 50, 10, 10]
                    width: self.minimum_width
                    spacing: 15
                    
        # Bottom Navigation Bar
        BottomNavBar:
