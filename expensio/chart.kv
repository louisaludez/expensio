<ChartScreen>:
    BoxLayout:
        orientation: "vertical"
        spacing: 0
        padding: 0

        # Top Bar
        TopBar:
        #Main Content Area
        ScrollView:
            do_scroll_x: False
            do_scroll_y: True
            BoxLayout:
                orientation: "vertical"
                padding: [15, 15, 15, 15]
                spacing: 10
                size_hint_y: None
                height: self.minimum_height  

                # Last Month Section
                BoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: 25
                    spacing: 10
                    
                   
                    Label:
                        text: 'Last Month'
                        size_hint_y: None
                        height: 20
                        font_size: 14
                        bold: True
                        halign: 'left'
                        valign: 'middle'
                        text_size: self.size
                        color: app.get_color_from_hex("#000000")
                
                # Budget text (indented)
                BoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: 20
                    padding: [30, 0, 0, 0]  
                    
                    Label:
                        id: last_month_budget_label
                        text: '₱ 0 was your previous budget.'
                        size_hint_x: 1
                        size_hint_y: None
                        height: 20
                        font_size: 12
                        halign: 'left'
                        valign: 'middle'
                        text_size: self.size
                        color: app.get_color_from_hex("#000000")
                
                # Gray separator line
                Widget:
                    size_hint_y: None
                    height: 1
                    canvas.before:
                        Color:
                            rgba: 0.7, 0.7, 0.7, 1 
                        Rectangle:
                            pos: self.pos
                            size: self.size

                # Current Month Section
                BoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: 25
                    spacing: 10
                    
                    Label:
                        text: 'Current Month'
                        size_hint_x: 1
                        size_hint_y: None
                        height: 20
                        font_size: 14
                        bold: True
                        halign: 'left'
                        valign: 'middle'
                        text_size: self.size
                        color: app.get_color_from_hex("#000000")
                    
                    Button:
                        id: edit_budget_btn
                        text: 'Edit'
                        size_hint: None, None
                        size: 50, 25
                        background_color: 0, 0, 0, 0
                        background_normal: ""
                        color: app.get_color_from_hex("#000000")
                        font_size: 14
                        bold: True
                        on_release:
                            root.edit_monthly_budget()
                
                # Motivational message
                BoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: 40
                    padding: [30, 5, 0, 0]  
                    
                    Label:
                        id: motivational_label
                        text: '[b][i][color=#AD590C]You are doing well in keeping on track with your budget![/color][/i][/b]'
                        markup: True
                        size_hint_x: 1
                        size_hint_y: None
                        height: 40
                        font_size: 14
                        halign: 'center'
                        valign: 'top'
                        text_size: self.size
                
                # View Budget Overview text
                BoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: 20
                    padding: [30, 0, 0, 0]  
                    
                    Label:
                        text: 'View Budget Overview for detailed summary.'
                        size_hint_x: 1
                        size_hint_y: None
                        height: 20
                        font_size: 10
                        halign: 'center'
                        valign: 'middle'
                        text_size: self.size
                        color: app.get_color_from_hex("#07344E")
                BoxLayout:
                    size_hint_y: None
                    height: 200
                    padding: [0, 20, 0, 20]
                    
                    Widget:
                        # Spacer to center content
                        size_hint_x: 1
                    
                    RelativeLayout:
                        size_hint: None, None
                        size: 180, 180
                        
                        CircularBudgetWidget:
                            id: budget_widget
                            size_hint: None, None
                            size: 180, 180
                            pos: 0, 0
                            progress: 0.0
                        
                        # Text content overlay
                        BoxLayout:
                            orientation: 'vertical'
                            size_hint: None, None
                            size: 140, 50
                            pos_hint: {'center_x': 0.5, 'center_y': 0.5}
                            spacing: 4
                            
                            # Budget amount label
                            Label:
                                id: budget_amount_label
                                text: "₱ 0"
                                halign: 'center'
                                valign: 'middle'
                                font_size: 20
                                bold: True
                                size_hint_y: None
                                height: 28
                                text_size: self.size
                                color: app.get_color_from_hex("#07344E")  
                            
                            Label:
                                text: "Monthly Budget"
                                halign: 'center'
                                valign: 'middle'
                                font_size: 10
                                size_hint_y: None
                                height: 16
                                text_size: self.size
                                color: app.get_color_from_hex("#666666")  
                    
                    Widget:
                        # Spacer to center content
                        size_hint_x: 1
                #Category Summary
                
                ScrollView:
                    do_scroll_x: True
                    do_scroll_y: False
                    size_hint_y: None
                    height: 80
                    BoxLayout:
                        orientation: 'horizontal'
                        size_hint_x: None
                        width: self.minimum_width
                        size_hint_y: None
                        height: 80
                        padding: [0, 5, 0, 5]
                        spacing: 8

                        # Transport Category Card
                        BoxLayout:
                            orientation: 'vertical'
                            size_hint: None, None
                            size: 100, 70
                            spacing: 4
                            padding: [10, 10, 10, 10]
                            canvas.before:
                                Color:
                                    rgba: 0.3, 0.3, 0.3, 1  
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [12]
                            canvas.after:
                                # Shadow effect
                                Color:
                                    rgba: 0, 0, 0, 0.2
                                RoundedRectangle:
                                    pos: self.x - 1, self.y - 1
                                    size: self.size
                                    radius: [12]
                            Label:
                                id: transport_count_label
                                text: "0"
                                font_size: 18
                                bold: True
                                halign: 'left'
                                valign: 'top'
                                text_size: self.size
                                color: 1, 1, 1, 1 
                                size_hint_y: None
                                height: 22
                            Label:
                                text: "Transport"
                                font_size: 12
                                halign: 'left'
                                valign: 'top'
                                text_size: self.size
                                color: app.get_color_from_hex("#AD590C")  
                                size_hint_y: None
                                height: 16

                        # Shopping Category Card
                        BoxLayout:
                            orientation: 'vertical'
                            size_hint: None, None
                            size: 100, 70
                            spacing: 4
                            padding: [10, 10, 10, 10]
                            canvas.before:
                                Color:
                                    rgba: 0.3, 0.3, 0.3, 1 
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [12]
                            canvas.after:
                                # Shadow effect
                                Color:
                                    rgba: 0, 0, 0, 0.2
                                RoundedRectangle:
                                    pos: self.x - 1, self.y - 1
                                    size: self.size
                                    radius: [12]
                            Label:
                                id: shopping_count_label
                                text: "0"
                                font_size: 18
                                bold: True
                                halign: 'left'
                                valign: 'top'
                                text_size: self.size
                                color: 1, 1, 1, 1  
                                size_hint_y: None
                                height: 22
                            Label:
                                text: "Shopping"
                                font_size: 12
                                halign: 'left'
                                valign: 'top'
                                text_size: self.size
                                color: app.get_color_from_hex("#AD590C") 
                                size_hint_y: None
                                height: 16

                        # Travel Category Card
                        BoxLayout:
                            orientation: 'vertical'
                            size_hint: None, None
                            size: 100, 70
                            spacing: 4
                            padding: [10, 10, 10, 10]
                            canvas.before:
                                Color:
                                    rgba: 0.3, 0.3, 0.3, 1  
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [12]
                            canvas.after:
                                # Shadow effect
                                Color:
                                    rgba: 0, 0, 0, 0.2
                                RoundedRectangle:
                                    pos: self.x - 1, self.y - 1
                                    size: self.size
                                    radius: [12]
                            Label:
                                id: travel_count_label
                                text: "0"
                                font_size: 18
                                bold: True
                                halign: 'left'
                                valign: 'top'
                                text_size: self.size
                                color: 1, 1, 1, 1  
                                size_hint_y: None
                                height: 22
                            Label:
                                text: "Travel"
                                font_size: 12
                                halign: 'left'
                                valign: 'top'
                                text_size: self.size
                                color: app.get_color_from_hex("#AD590C")  
                                size_hint_y: None
                                height: 16

                        # Skincare Category Card
                        BoxLayout:
                            orientation: 'vertical'
                            size_hint: None, None
                            size: 100, 70
                            spacing: 4
                            padding: [10, 10, 10, 10]
                            canvas.before:
                                Color:
                                    rgba: 0.3, 0.3, 0.3, 1 
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [12]
                            canvas.after:
                                # Shadow effect
                                Color:
                                    rgba: 0, 0, 0, 0.2
                                RoundedRectangle:
                                    pos: self.x - 1, self.y - 1
                                    size: self.size
                                    radius: [12]
                            Label:
                                id: skincare_count_label
                                text: "0"
                                font_size: 18
                                bold: True
                                halign: 'left'
                                valign: 'top'
                                text_size: self.size
                                color: 1, 1, 1, 1  
                                size_hint_y: None
                                height: 22
                            Label:
                                text: "Skincare"
                                font_size: 12
                                halign: 'left'
                                valign: 'top'
                                text_size: self.size
                                color: app.get_color_from_hex("#AD590C")  
                                size_hint_y: None
                                height: 16

                        # Food Category Card
                        BoxLayout:
                            orientation: 'vertical'
                            size_hint: None, None
                            size: 100, 70
                            spacing: 4
                            padding: [10, 10, 10, 10]
                            canvas.before:
                                Color:
                                    rgba: 0.3, 0.3, 0.3, 1 
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [12]
                            canvas.after:
                                # Shadow effect
                                Color:
                                    rgba: 0, 0, 0, 0.2
                                RoundedRectangle:
                                    pos: self.x - 1, self.y - 1
                                    size: self.size
                                    radius: [12]
                            Label:
                                id: food_count_label
                                text: "0"
                                font_size: 18
                                bold: True
                                halign: 'left'
                                valign: 'top'
                                text_size: self.size
                                color: 1, 1, 1, 1  
                                size_hint_y: None
                                height: 22
                            Label:
                                text: "Food"
                                font_size: 12
                                halign: 'left'
                                valign: 'top'
                                text_size: self.size
                                color: app.get_color_from_hex("#AD590C") 
                                size_hint_y: None
                                height: 16

                        # Insurance Category Card
                        BoxLayout:
                            orientation: 'vertical'
                            size_hint: None, None
                            size: 100, 70
                            spacing: 4
                            padding: [10, 10, 10, 10]
                            canvas.before:
                                Color:
                                    rgba: 0.3, 0.3, 0.3, 1 
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [12]
                            canvas.after:
                                # Shadow effect
                                Color:
                                    rgba: 0, 0, 0, 0.2
                                RoundedRectangle:
                                    pos: self.x - 1, self.y - 1
                                    size: self.size
                                    radius: [12]
                            Label:
                                id: insurance_count_label
                                text: "0"
                                font_size: 18
                                bold: True
                                halign: 'left'
                                valign: 'top'
                                text_size: self.size
                                color: 1, 1, 1, 1  
                                size_hint_y: None
                                height: 22
                            Label:
                                text: "Insurance"
                                font_size: 12
                                halign: 'left'
                                valign: 'top'
                                text_size: self.size
                                color: app.get_color_from_hex("#AD590C")
                                size_hint_y: None
                                height: 16

                        # Water Category Card
                        BoxLayout:
                            orientation: 'vertical'
                            size_hint: None, None
                            size: 100, 70
                            spacing: 4
                            padding: [10, 10, 10, 10]
                            canvas.before:
                                Color:
                                    rgba: 0.3, 0.3, 0.3, 1  
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [12]
                            canvas.after:
                                # Shadow effect
                                Color:
                                    rgba: 0, 0, 0, 0.2
                                RoundedRectangle:
                                    pos: self.x - 1, self.y - 1
                                    size: self.size
                                    radius: [12]
                            Label:
                                id: water_count_label
                                text: "0"
                                font_size: 18
                                bold: True
                                halign: 'left'
                                valign: 'top'
                                text_size: self.size
                                color: 1, 1, 1, 1 
                                size_hint_y: None
                                height: 22
                            Label:
                                text: "Water"
                                font_size: 12
                                halign: 'left'
                                valign: 'top'
                                text_size: self.size
                                color: app.get_color_from_hex("#AD590C")  
                                size_hint_y: None
                                height: 16

                        # Electricity Category Card
                        BoxLayout:
                            orientation: 'vertical'
                            size_hint: None, None
                            size: 100, 70
                            spacing: 4
                            padding: [10, 10, 10, 10]
                            canvas.before:
                                Color:
                                    rgba: 0.3, 0.3, 0.3, 1 
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [12]
                            canvas.after:
                                # Shadow effect
                                Color:
                                    rgba: 0, 0, 0, 0.2
                                RoundedRectangle:
                                    pos: self.x - 1, self.y - 1
                                    size: self.size
                                    radius: [12]
                            Label:
                                id: electricity_count_label
                                text: "0"
                                font_size: 18
                                bold: True
                                halign: 'left'
                                valign: 'top'
                                text_size: self.size
                                color: 1, 1, 1, 1 
                                size_hint_y: None
                                height: 22
                            Label:
                                text: "Electricity"
                                font_size: 12
                                halign: 'left'
                                valign: 'top'
                                text_size: self.size
                                color: app.get_color_from_hex("#AD590C") 
                                size_hint_y: None
                                height: 16

                
  
        # Bottom Navigation Bar
        BottomNavBar:






