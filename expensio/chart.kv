<ChartScreen>:
    BoxLayout:
        orientation: "vertical"
        spacing: 0
        padding: 0

        # Top Bar
        TopBar:
        #Main Content Area
        ScrollView:
            do_scroll_x: False
            do_scroll_y: True
            BoxLayout:
                orientation: "vertical"
                padding: [15, 15, 15, 15]
                spacing: 10
                size_hint_y: None
                height: self.minimum_height  

                # Last Month Section
                BoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: 25
                    spacing: 10
                    
                   
                    Label:
                        text: 'Last Month'
                        size_hint_y: None
                        height: 20
                        font_size: 14
                        bold: True
                        halign: 'left'
                        valign: 'middle'
                        text_size: self.size
                        color: app.get_color_from_hex("#000000")
                
                # Budget text (indented)
                BoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: 20
                    padding: [30, 0, 0, 0]  # Indent to align with text after radio button
                    
                    Label:
                        text: '₱ 20, 800 was your previous budget.'
                        size_hint_x: 1
                        size_hint_y: None
                        height: 20
                        font_size: 12
                        halign: 'left'
                        valign: 'middle'
                        text_size: self.size
                        color: app.get_color_from_hex("#000000")
                
                # Gray separator line
                Widget:
                    size_hint_y: None
                    height: 1
                    canvas.before:
                        Color:
                            rgba: 0.7, 0.7, 0.7, 1  # Gray color
                        Rectangle:
                            pos: self.pos
                            size: self.size

                # Current Month Section
                BoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: 25
                    spacing: 10
                    
                    
                    Label:
                        text: 'Current Month'
                        size_hint_y: None
                        height: 20
                        font_size: 14
                        bold: True
                        halign: 'left'
                        valign: 'middle'
                        text_size: self.size
                        color: app.get_color_from_hex("#000000")
                
                # Motivational message
                BoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: 40
                    padding: [30, 5, 0, 0]  # Indent to align with text after radio button
                    
                    Label:
                        text: '[b][i][color=#AD590C]You are doing well in keeping on track with your budget![/color][/i][/b]'
                        markup: True
                        size_hint_x: 1
                        size_hint_y: None
                        height: 40
                        font_size: 14
                        halign: 'center'
                        valign: 'top'
                        text_size: self.size
                
                # View Budget Overview text
                BoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: 20
                    padding: [30, 0, 0, 0]  # Indent to align with text after radio button
                    
                    Label:
                        text: 'View Budget Overview for detailed summary.'
                        size_hint_x: 1
                        size_hint_y: None
                        height: 20
                        font_size: 10
                        halign: 'center'
                        valign: 'middle'
                        text_size: self.size
                        color: app.get_color_from_hex("#07344E")
                BoxLayout:
                    size_hint_y: None
                    height: 200
                    padding: [0, 20, 0, 20]
                    
                    Widget:
                        # Spacer to center content
                        size_hint_x: 1
                    
                    RelativeLayout:
                        size_hint: None, None
                        size: 180, 180
                        
                        CircularBudgetWidget:
                            size_hint: None, None
                            size: 180, 180
                            pos: 0, 0
                            progress: 0.85
                        
                        # Text content overlay
                        BoxLayout:
                            orientation: 'vertical'
                            size_hint: None, None
                            size: 140, 50
                            pos_hint: {'center_x': 0.5, 'center_y': 0.5}
                            spacing: 4
                            
                            Label:
                                text: "₱ 20,650"
                                halign: 'center'
                                valign: 'middle'
                                font_size: 20
                                bold: True
                                size_hint_y: None
                                height: 28
                                text_size: self.size
                                color: app.get_color_from_hex("#07344E")  # Dark teal
                            
                            Label:
                                text: "Monthly Budget"
                                halign: 'center'
                                valign: 'middle'
                                font_size: 10
                                size_hint_y: None
                                height: 16
                                text_size: self.size
                                color: app.get_color_from_hex("#666666")  # Gray
                    
                    Widget:
                        # Spacer to center content
                        size_hint_x: 1
                #Category Summary
                
                
                BoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: 80
                    padding: [0, 5, 0, 5]
                    spacing: 8

                    # Food Category Card
                    BoxLayout:
                        orientation: 'vertical'
                        size_hint_x: 1
                        spacing: 4
                        padding: [10, 10, 10, 10]
                        canvas.before:
                            Color:
                                rgba: 0.3, 0.3, 0.3, 1  # Dark gray background
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [12]
                        canvas.after:
                            # Shadow effect
                            Color:
                                rgba: 0, 0, 0, 0.2
                            RoundedRectangle:
                                pos: self.x - 1, self.y - 1
                                size: self.size
                                radius: [12]
                        Label:
                            text: "2"
                            font_size: 18
                            bold: True
                            halign: 'left'
                            valign: 'top'
                            text_size: self.size
                            color: 1, 1, 1, 1  # White
                            size_hint_y: None
                            height: 22
                        Label:
                            text: "Food"
                            font_size: 12
                            halign: 'left'
                            valign: 'top'
                            text_size: self.size
                            color: app.get_color_from_hex("#AD590C")  # Orange
                            size_hint_y: None
                            height: 16

                    # Transpo Category Card
                    BoxLayout:
                        orientation: 'vertical'
                        size_hint_x: 1
                        spacing: 4
                        padding: [10, 10, 10, 10]
                        canvas.before:
                            Color:
                                rgba: 0.3, 0.3, 0.3, 1  # Dark gray background
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [12]
                        canvas.after:
                            # Shadow effect
                            Color:
                                rgba: 0, 0, 0, 0.2
                            RoundedRectangle:
                                pos: self.x - 1, self.y - 1
                                size: self.size
                                radius: [12]
                        Label:
                            text: "1,598"
                            font_size: 18
                            bold: True
                            halign: 'left'
                            valign: 'top'
                            text_size: self.size
                            color: 1, 1, 1, 1  # White
                            size_hint_y: None
                            height: 22
                        Label:
                            text: "Transpo"
                            font_size: 12
                            halign: 'left'
                            valign: 'top'
                            text_size: self.size
                            color: app.get_color_from_hex("#AD590C")  # Orange
                            size_hint_y: None
                            height: 16

                    # Shopping Category Card
                    BoxLayout:
                        orientation: 'vertical'
                        size_hint_x: 1
                        spacing: 4
                        padding: [10, 10, 10, 10]
                        canvas.before:
                            Color:
                                rgba: 0.3, 0.3, 0.3, 1  # Dark gray background
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [12]
                        canvas.after:
                            # Shadow effect
                            Color:
                                rgba: 0, 0, 0, 0.2
                            RoundedRectangle:
                                pos: self.x - 1, self.y - 1
                                size: self.size
                                radius: [12]
                        Label:
                            text: "1,246"
                            font_size: 18
                            bold: True
                            halign: 'left'
                            valign: 'top'
                            text_size: self.size
                            color: 1, 1, 1, 1  # White
                            size_hint_y: None
                            height: 22
                        Label:
                            text: "Shopping"
                            font_size: 12
                            halign: 'left'
                            valign: 'top'
                            text_size: self.size
                            color: app.get_color_from_hex("#AD590C")  # Orange
                            size_hint_y: None
                            height: 16

                
  
        # Bottom Navigation Bar
        BottomNavBar:






